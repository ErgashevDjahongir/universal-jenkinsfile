# Backend muhit o'zgaruvchilari namunasi.
# Haqiqiy qiymatlar bilan `.env` faylga nusxalang (`.env` commit QILINMAYDI).

# Ilova
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Ma'lumotlar bazasi (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=etest
DB_PASSWORD=etest_dev_password
DB_NAME=etest

# Redis (kesh/sessiya)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (access token)
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m

# Sessiya: harakatsizlik oynasi (refresh token Redis TTL, daqiqa)
SESSION_IDLE_MINUTES=30

# Parol xeshlash (bcrypt cost)
BCRYPT_COST=12

# Boshlang'ich super-admin urug'i (seed:admin)
SEED_ADMIN_LOGIN=superadmin
SEED_ADMIN_PASSWORD=ChangeMe123
