# Backend muhit o'zgaruvchilari namunasi.
# Haqiqiy qiymatlar bilan `.env` faylga nusxalang (`.env` commit QILINMAYDI).

# Ilova
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Ma'lumotlar bazasi (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=etest
DB_PASSWORD=etest_dev_password
DB_NAME=etest

# Redis (kesh/sessiya)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (2-bosqichda ishlatiladi)
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Parol xeshlash
BCRYPT_COST=12
