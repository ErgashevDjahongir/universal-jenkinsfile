# =============================================================================
# E-TEST — PRODUCTION .env namunasi
# -----------------------------------------------------------------------------
# Bu FAQAT namuna. Server'da nusxa oling va to'ldiring:
#     cp .env.prod.example .env
# `.env` hech qachon git'ga commit qilinmaydi.
#
# Bu bitta `.env` ikki maqsadda ishlatiladi:
#   1) docker compose o'zgaruvchilarini almashtirish (${...})
#   2) backend konteyneriga env_file orqali yuborish
#
# "🔴 O'ZGARTIRING" belgili qatorlar productionda MAJBURIY almashtiriladi.
# =============================================================================

# --- Tashqi HTTP port (Nginx/frontend) ---
# 80 standart. Boshqa xizmat 80'ni egallagan bo'lsa o'zgartiring (masalan 8080).
HTTP_PORT=80

# --- CORS / server manzili ---
# 🔴 O'ZGARTIRING: server statik IP yoki domeni. Frontend Nginx orqali bir xil
# origin'da ishlagani uchun bu odatda shu serverning manzili.
# Bir nechta manzilni vergul bilan ajrating: http://192.168.1.50,http://etest.local
CORS_ORIGIN=http://192.168.1.50

# --- PostgreSQL ---
DB_USERNAME=etest
# 🔴 O'ZGARTIRING: kuchli parol (kamida 16 belgi, tasodifiy). Masalan:
#     openssl rand -base64 24
DB_PASSWORD=__O_ZGARTIRING_kuchli_db_paroli__
DB_NAME=etest
# Backend ulanish hovuzi (bitta backend instansiyasi uchun). ~100 sessiyaga 20 yetarli.
DB_POOL_MAX=20

# --- JWT (access token) ---
# 🔴 O'ZGARTIRING: kuchli tasodifiy kalit (>= 48 belgi). Yarating:
#     openssl rand -hex 32
# Refresh token JWT EMAS — u Redis'da saqlanadigan tasodifiy token (sliding session),
# shu sababli alohida JWT_REFRESH_SECRET kerak emas.
JWT_SECRET=__O_ZGARTIRING_openssl_rand_hex_32__
JWT_EXPIRES_IN=15m

# Sessiya harakatsizlik oynasi (daqiqa) — refresh token TTL'i ham shunga teng
SESSION_IDLE_MINUTES=30

# bcrypt cost (>= 10). Productionda 12 tavsiya etiladi.
BCRYPT_COST=12

# --- Boshlang'ich super-admin (faqat seed:admin:prod uchun) ---
SEED_ADMIN_LOGIN=superadmin
# 🔴 O'ZGARTIRING: kuchli parol (kamida 8 belgi, harf + raqam). Dev'dagi
# ChangeMe123 ni ISHLATMANG. Birinchi kirgandan keyin almashtiring.
SEED_ADMIN_PASSWORD=__O_ZGARTIRING_kuchli_admin_paroli__
